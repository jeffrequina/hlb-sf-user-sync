{
  "name": "hlb-sf-user-sync",
  "version": "1.0.0",
  "description": "HLB Azure Function REST API to sync Salesforce users to Hivebrite",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "rimraf dist && tsc",
    "build:watch": "tsc --watch",
    "start": "npm run build && func start",
    "start:dev": "func start",
    "test": "echo \"No tests configured\" && exit 0",
    "prestart": "npm run build",
    "clean": "rimraf dist"
  },
  "keywords": [
    "azure-functions",
    "salesforce",
    "hivebrite",
    "user-sync",
    "serverless"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@azure/functions": "^4.11.2",
    "axios": "^1.7.9",
    "winston": "^3.19.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.19.35",
    "rimraf": "^5.0.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
